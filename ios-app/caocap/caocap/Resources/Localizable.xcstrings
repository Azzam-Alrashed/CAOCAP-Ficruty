    "help.article.videoCall.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على الزر العائم واختر الفيديو لبدء مكالمة مباشرة مع مساعدك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Long-press the floating action button and choose Video to start a live call with your copilot."
          }
        }
      }
    },
    "help.article.videoCall.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من شريط المكالمة يمكنك كتم الصوت، وتشغيل أو إيقاف مشاركة الشاشة، وإنهاء المكالمة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the call chrome you can mute, toggle screen sharing, or end the call."
          }
        }
      }
    },
    "help.article.videoCall.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب iOS إذن تسجيل الشاشة في كل مرة تبدأ فيها مشاركة جديدة — وهذا سلوك النظام وليس خطأ في التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS asks for Screen Recording permission each time you start a new share session — that is system behavior, not an app bug."
          }
        }
      }
    },
    "help.article.videoCall.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرشاد مباشر مع مشاركة الشاشة الاختيارية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live guidance with optional screen share"
          }
        }
      }
    },
    "help.article.videoCall.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
