    "help.article.canvas.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللوحة الرئيسية مساحة عمل غير محدودة. تبدأ بعقدة Hello World — ويمكنك إضافة تطبيقات مصغّرة ولوحات فرعية أثناء البناء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your home canvas is an infinite workspace. It starts with a Hello World mini-app — add more mini-apps and nested canvases as you build."
          }
        }
      }
    },
    "help.article.canvas.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للتنقل، قرّب للتركيز، واضغط على العقدة لفتح ما تحتويه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag to pan, pinch to zoom, and tap a node to open what it contains."
          }
        }
      }
    },
    "help.article.canvas.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pan, zoom, and organize your spatial workspace"
          }
        }
      }
    },
    "help.article.canvas.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canvas & nodes"
          }
        }
      }
    },
    "help.article.cocaptain.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoCaptain reads your current canvas and helps you plan, explain, and edit mini-apps. Open chat from the FAB, or start a video call for live guidance."
          }
        }
      }
    },
    "help.article.cocaptain.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code and structural changes stay in review until you approve them."
          }
        }
      }
    },
    "help.article.cocaptain.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use View on Canvas inside a review card to inspect the target node before applying. Node-scoped reviews stay pending until you approve or reject them, even if you leave and return later."
          }
        }
      }
    },
    "help.article.cocaptain.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat, video call, and human-in-the-loop edits"
          }
        }
      }
    },
    "help.article.cocaptain.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CoCaptain & review"
          }
        }
      }
    },
    "help.article.miniapps.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini-App nodes bundle HTML, CSS, and JavaScript with a live preview on the canvas."
          }
        }
      }
    },
    "help.article.miniapps.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a mini-app to run the preview, then use the Command Line while you iterate."
          }
        }
      }
    },
    "help.article.miniapps.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Build runnable HTML/CSS/JS on the canvas"
          }
        }
      }
    },
    "help.article.miniapps.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mini-Apps & live preview"
          }
        }
      }
    },
    "help.article.nextSteps.body1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهيت البرنامج التعليمي للمرة الأولى. تطبيق Hello World المصغّر موجود على اللوحة الرئيسية — اضغطه في أي وقت لفتح المعاينة الحية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You finished the first-run tutorial. Your Hello World mini-app is on the home canvas — tap it anytime to open the live preview."
          }
        }
      }
    },
    "help.article.nextSteps.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما تكون جاهزاً للجلسة ٢، اطلب من CoCaptain تحويل Hello World إلى لعبة صغيرة بسيطة. راجع كل اقتراح واضغط «تطبيق» — لا يتغير شيء حتى توافق عليه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you are ready for session 2, ask CoCaptain to turn Hello World into a simple mini game. Review each suggestion and tap Apply — nothing changes until you approve it."
          }
        }
      }
    },
    "help.article.nextSteps.body3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد أي درس تفاعلي من المساعدة → الدروس التفاعلية عندما تريد التمرين مرة أخرى."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replay any interactive lesson from Help → Interactive lessons whenever you want more practice."
          }
        }
      }
    },
    "help.article.nextSteps.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجلسة ٢ — طوّر تطبيق Hello World"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session 2 — grow your Hello World app"
          }
        }
      }
    },
    "help.article.nextSteps.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
