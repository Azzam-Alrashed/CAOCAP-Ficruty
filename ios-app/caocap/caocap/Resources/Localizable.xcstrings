      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the floating action button to open the Command Line."
          }
        }
      }
    },
    "help.article.omnibox.body2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type an action name or a natural phrase like \"open settings\". Unmatched text can be sent to CoCaptain."
